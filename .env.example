# ============================================================
# cowork_trigger_mcp — environment variables
# Copy to .env, fill in your values, never commit .env.
# ============================================================

# Anthropic API key — from console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Default model for new agent definitions
COWORK_DEFAULT_MODEL=claude-sonnet-4-6

# Port for the streamable-HTTP MCP transport
MCP_PORT=8080

# Request timeout in seconds (increase for very long-running sessions)
REQUEST_TIMEOUT_SECONDS=120

# Optional: override the Anthropic base URL (for proxies or Bedrock/Vertex)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
